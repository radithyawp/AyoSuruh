+            child: const Text('Hapus'),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true) return;
+    try {
+      await _service.deleteService(item['id'].toString());
+      await _load();
+    } catch (error) {
+      _message('Jasa belum dapat dihapus: $error', error: true);
+    }
+  }
+
+  void _message(String message, {bool error = false}) {
